      replacement_content: "import { Deal, Order } from \'./types\';\n\nexport const mockDeals: Deal[] = [\n  {\n    id: \'pizza-mystery-bag\',\n    title: \'Late Night Pizza Mystery Bag\',\n    vendor: \'Dominos\',\n    campus: \'Main Campus\',\n    originalPrice: 1200,\n    dealPrice: 450,\n    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuAtNq8ahCnWGJ_h3M6X4EnRVITU1HstTdfvG5gTpVZA1zyLLAWWnYDCCHa0yDMV6yZ4qtT1HrbO6L5New8nG9Emt-CIb5l8xHF49S6fAzJfJVab1LgXqbz1Ho2FAgc4ObMWRTEhiujRyAMA-_yYhrjPMosDKpmHxXGIdonysnXYhAw4XSsWSXxXjHcvagZZ3DPRCb2YWSJif_e0QlM48hqz2qBqa9f2fFGW4tVQe3cE1ddlRSCNSGy23xfVwyV4EOYz-tpvwvADdDo\',\n    discountPercentage: 62,\n    timeStart: \'8:00 PM\',\n    timeEnd: \'9:30 PM\',\n    category: \'Pizza\',\n    tags: [\'Fresh Baked\', \'Cheesy goodness\'],\n    description: \'Get an assortment of piping hot slices or a whole premium pizza saved from our dinner batch. Includes bubbling mozzarella, rich pepperoni, or supreme veggie toppings. An incredible deal for late-night study sessions!\',\n    stockCount: 3,\n    durationRemaining: \'01:24:52\'\n  },\n  {\n    id: \'premium-sushi\',\n    title: \'Premium Sushi Selection\',\n    vendor: \'Zen Garden\',\n    campus: \'Lower Kabete\',\n    originalPrice: 1500,\n    dealPrice: 600,\n    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuCKw927xyQb_AD_gT6-94SSVmd8kHmPr1ErcDw9VBTv8jVo7daIdAOkrFhRp_TXU-AgoDbY7Cs7RJA_T21-3TmnFm8HJtGn8V4ozmAiB3ncM2pccAzFzam4Tro7G7w9LP66RLk-bKlignNL2rgC5JSpuZmsGmX3BOmkKhUaokZFc1eUl942VgBvMkBHrUyIwHrxDfLN2qRdaBT9tBdl8FIh8y02YxwiW_WI1rnId6I10B8ocr2KZYW1tu_8Z7ODRkT2FnVCuA7v76M\',\n    discountPercentage: 60,\n    timeStart: \'4:00 PM\',\n    timeEnd: \'5:00 PM\',\n    category: \'Sushi\',\n    tags: [\'Fresh Fish\', \'Authentic Japanese\'],\n    description: \'A delicate arrangement of premium sushi rolls and fresh sashimi prepared by master chefs. Includes spicy tuna, California rolls, and fresh salmon nigiri saved from the afternoon prep. A high-end expe