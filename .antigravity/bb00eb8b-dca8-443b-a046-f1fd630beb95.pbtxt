  file_change {
    absolute_path_uri: "file:///src/vendor/VendorApp.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Package, TrendingUp, Settings, LogOut, Plus, Search } from \'lucide-react\';\nimport { mockDeals } from \'../data\';\nimport Price from \'../components/Price\';\nimport DealCard from \'../components/DealCard\';\n\nexport default function VendorApp() {\n  const [activeTab, setActiveTab] = useState<\'DASHBOARD\' | \'DEALS\' | \'SETTINGS\'>(\'DASHBOARD\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n\n  const activeDeals = mockDeals.filter(d => d.vendor === \'Dominos\'); // Mock vendor filter\n\n  return (\n    <div className=\"min-h-screen bg-[#FFF8F6] text-[#111827] font-sans flex flex-col md:flex-row antialiased\">\n      {/* Sidebar for Desktop / Topnav for mobile */}\n      <aside className=\"w-full md:w-64 bg-white border-r border-[#F3F4F6] p-4 flex flex-col gap-6 md:h-screen sticky top-0 z-40 shadow-sm md:shadow-none\">\n        <div className=\"flex items-center justify-between md:justify-center px-2 py-4 border-b border-[#F3F4F6] md:border-none\">\n          <h1 className=\"font-display font-extrabold text-2xl tracking-tight text-[#FF6B00]\">DealPlate</h1>\n          <span className=\"text-xs bg-[#FF6B00]/10 text-[#FF6B00] px-2 py-1 rounded-full font-bold ml-2\">Partner</span>\n        </div>\n\n        <nav className=\"flex md:flex-col gap-2 overflow-x-auto no-scrollbar\">\n          <button\n            onClick={() => setActiveTab(\'DASHBOARD\')}\n            className={`flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition-all whitespace-nowrap ${\n              activeTab === \'DASHBOARD\' ? \'bg-[#FF6B00] text-white shadow-md\' : \'text-[#5a4136] hover:bg-gray-50\'\n            }`}\n          >\n            <TrendingUp className=\"w-5 h-5\" />\n            <span>Dashboard</span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'DEALS\')}\n            className={`flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition-all whitespace-nowrap ${\n              activeTab === \'DEALS\' ? \'bg-[#FF6B00] text-white shadow-md\' : \'text-[#5a4136] hover:bg-gray-50\'\n            }`}\n          >\n            <Package className=\"w-5 h-5\" />\n            <span>Active Deals</span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'SETTINGS\')}\n            className={`flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition-all whitespace-nowrap ${\n              activeTab === \'SETTINGS\' ? \'bg-[#FF6B00] text-white shadow-md\' : \'text-[#5a4136] hover:bg-gray-50\'\n            }`}\n          >\n            <Settings className=\"w-5 h-5\" />\n            <span>Settings</span>\n          </button>\n        </nav>\n\n        <div className=\"mt-auto hidden md:block px-2\">\n          <button className=\"flex items-center gap-3 text-red-500 font-semibold hover:bg-red-50 px-4 py-3 rounded-xl transition-colors w-full\">\n            <LogOut className=\"w-5 h-5\" />\n            <span>Sign Out</span>\n          </button>\n        </div>\n      </aside>\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 p-6 max-w-5xl mx-auto w-full\">\n        {activeTab === \'DASHBOARD\' && (\n          <div className=\"space-y-6\">\n            <div>\n              <h2 className=\"font-display font-extrabold text-3xl text-[#111827]\">Overview</h2>\n              <p className=\"text-[#5a4136] text-sm\">Welcome back, Dominos! Here\'s how your deals are performing.</p>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n              <div className=\"bg-white p-6 rounded-2xl border border-[#F3F4F6] shadow-sm\">\n                <span className=\"text-[#5a4136] font-semibold text-sm\">Revenue Recovered</span>\n                <div className=\"mt-2 text-3xl font-display font-extrabold text-[#111827]\">\n                  <Price amount={14500} size=\"xl\" className=\"text-[#FF6B00]\" />\n                </div>\n              </div>\n              <div className=\"bg-white p-6 rounded-2xl border border-[#F3F4F6] shadow-sm\">\n                <span className=\"text-[#5a4136] font-semibold text-sm\">Meals Saved</span>\n                <div className=\"mt-2 text-3xl font-display font-extrabold text-[#111827]\">24</div>\n              </div>\n              <div className=\"bg-white p-6 rounded-2xl border border-[#F3F4F6] shadow-sm\">\n                <span className=\"text-[#5a4136] font-semibold text-sm\">Active Views</span>\n                <div className=\"mt-2 text-3xl font-display font-extrabold text-[#111827]\">156</div>\n              </div>\n            </div>\n\n            <div className=\"bg-white p-6 rounded-2xl border border-[#F3F4F6] shadow-sm\">\n              <h3 className=\"font-display font-bold text-lg mb-4\">Recent Transactions</h3>\n              <div className=\"text-center py-10 text-gray-400 text-sm\">\n                No recent transactions today.\n              </div>\n            </div>\n          </div>\n        )}\n\n        {activeTab === \'DEALS\' && (\n          <div className=\"space-y-6\">\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n              <div>\n                <h2 className=\"font-display font-extrabold text-3xl text-[#111827]\">Manage Deals</h2>\n                <p className=\"text-[#5a4136] text-sm\">Create and monitor your active flash deals.</p>\n              </div>\n              <button className=\"bg-[#FF6B00] text-white px-5 py-3 rounded-xl font-bold shadow-md hover:bg-[#e66000] active:scale-95 transition-all flex items-center justify-center gap-2\">\n                <Plus className=\"w-5 h-5\" />\n                <span>Create Deal</span>\n              </button>\n            </div>\n\n            <div className=\"relative\">\n              <Search className=\"absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5\" />\n              <input\n                type=\"text\"\n                placeholder=\"Search your deals...\"\n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                className=\"w-full h-12 pl-12 pr-4 rounded-xl border border-gray-200 bg-white focus:ring-2 focus:ring-[#FF6B00] outline-none transition-all\"\n              />\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n              {activeDeals.map(deal => (\n                <div key={deal.id} className=\"relative group\">\n                  <DealCard\n                    deal={deal}\n                    onSelect={() => {}}\n                    onQuickReserve={() => {}}\n                  />\n                  {/* Vendor overlay controls could go here */}\n                  <div className=\"absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-bold text-[#FF6B00] shadow-sm pointer-events-none\">\n                    Preview\n                  </div>\n                </div>\n              ))}\n              {activeDeals.length === 0 && (\n                <div className=\"col-span-full py-12 text-center text-gray-500\">\n                  No active deals found. Click \"Create Deal\" to post surplus food.\n                </div>\n              )}\n            </div>\n          </div>\n        )}\n\n        {activeTab === \'SETTINGS\' && (\n          <div className=\"space-y-6 max-w-2xl\">\n            <div>\n              <h2 className=\"font-display font-extrabold text-3xl text-[#111827]\">Settings</h2>\n              <p className=\"text-[#5a4136] text-sm\">Manage your store profile and payout details.</p>\n            </div>\n\n            <div className=\"bg-white rounded-2xl border border-[#F3F4F6] shadow-sm p-6 space-y-4\">\n              <h3 className=\"font-bold text-lg border-b border-gray-100 pb-2\">Store Profile</h3>\n              <div>\n                <label className=\"block text-xs font-bold text-[#5a4136] uppercase tracking-wider mb-2\">Store Name</label>\n                <input type=\"text\" defaultValue=\"Dominos\" className=\"w-full h-12 px-4 rounded-lg border border-gray-200 focus:ring-[#FF6B00]\" />\n              </div>\n              <div>\n                <label className=\"block text-xs font-bold text-[#5a4136] uppercase tracking-wider mb-2\">Campus Location</label>\n                <input type=\"text\" defaultValue=\"Main Campus\" className=\"w-full h-12 px-4 rounded-lg border border-gray-200 focus:ring-[#FF6B00]\" />\n              </div>\n            </div>\n\n            <div className=\"bg-white rounded-2xl border border-[#F3F4F6] shadow-sm p-6 space-y-4\">\n              <h3 className=\"font-bold text-lg border-b border-gray-100 pb-2\">Payout Configuration (Daraja)</h3>\n              <div>\n                <label className=\"block text-xs font-bold text-[#5a4136] uppercase tracking-wider mb-2\">Till / Paybill Number</label>\n                <input type=\"text\" defaultValue=\"888123\" className=\"w-full h-12 px-4 rounded-lg border border-gray-200 focus:ring-[#FF6B00]\" />\n              </div>\n            </div>\n\n            <button className=\"bg-[#FF6B00] text-white px-6 py-3 rounded-xl font-bold shadow-md hover:bg-[#e66000] active:scale-95 transition-all\">\n              Save Changes\n            </button>\n          </div>\n        )}\n      </main>\n    </div>\n  );\n}\n"
    }
