  file_change {
    absolute_path_uri: "file:///src/components/DealCard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Store, ShoppingBag } from \'lucide-react\';\nimport { Deal } from \'../types\';\nimport Price from \'./Price\';\nimport Timer from \'./Timer\';\n\ninterface DealCardProps {\n  deal: Deal;\n  onSelect: (deal: Deal) => void;\n  onQuickReserve: (deal: Deal, e: React.MouseEvent) => void;\n}\n\nexport default function DealCard({ deal, onSelect, onQuickReserve }: DealCardProps) {\n  // Parse remaining duration string \"hh:mm:ss\" to seconds\n  const parseRemainingSeconds = (duration: string) => {\n    const parts = duration.split(\':\').map(Number);\n    if (parts.length === 3) {\n      return parts[0] * 3600 + parts[1] * 60 + parts[2];\n    }\n    return 3600; // default 1 hour\n  };\n\n  return (\n    <article\n      onClick={() => onSelect(deal)}\n      className=\"break-inside-avoid bg-white rounded-xl overflow-hidden border border-[#F3F4F6] shadow-sm hover:shadow-md transition-all duration-300 active:scale-[0.99] group cursor-pointer relative flex flex-col mb-4\"\n    >\n      {/* Aspect-Video Top Image */}\n      <div className=\"relative w-full aspect-video bg-[#F3F4F6] overflow-hidden\">\n        <img\n          className=\"absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n          src={deal.image}\n          alt={deal.title}\n          loading=\"lazy\"\n        />\n        {/* Absolute Positioned Discount Badge */}\n        <div className=\"absolute top-3 left-3 bg-[#E11D48] text-white text-xs font-bold px-3 py-1 rounded-full shadow-md\">\n          {deal.discountPercentage}% OFF\n        </div>\n      </div>\n\n      {/* Content Area */}\n      <div className=\"p-4 flex flex-col flex-1 gap-2\">\n        <h3 className=\"font-display font-bold text-lg text-[#111827] line-clamp-1 group-hover:text-[#FF6B00] transition-colors\">\n          {deal.title}\n        </h3>\n\n        <div className=\"flex items-center gap-1.5 text-xs text-[#5a4136]\">\n          <Store className=\"w-3.5 h-3.5 text-[#FF6B00]\" />\n          <span>{deal.vendor} - {deal.campus}</span>\n        </div>\n\n        <div className=\"flex items-center justify-between mt-1\">\n          <Timer initialSeconds={parseRemainingSeconds(deal.durationRemaining)} />\n          <span className=\"text-xs font-bold text-[#E11D48] bg-[#E11D48]/10 px-2 py-0.5 rounded-full\">\n            Only {deal.stockCount} left!\n          </span>\n        </div>\n\n        {/* Action / Pricing Footer */}\n        <div className=\"mt-4 flex items-end justify-between pt-3 border-t border-[#F3F4F6]\">\n          <div className=\"flex flex-col\">\n            <span className=\"text-xs text-gray-400 line-through\">\n              Ksh {deal.originalPrice.toLocaleString()}\n            </span>\n            <Price amount={deal.dealPrice} size=\"lg\" className=\"text-[#FF6B00]\" />\n          </div>\n\n          <button\n            onClick={(e) => {\n              e.stopPropagation();\n              onQuickReserve(deal, e);\n            }}\n            className=\"h-12 w-12 rounded-full bg-[#FF6B00] text-white flex items-center justify-center shadow-md hover:bg-[#e66000] active:scale-90 transition-all duration-200\"\n            aria-label=\"Add deal to cart\"\n          >\n            <ShoppingBag className=\"w-5 h-5\" />\n          </button>\n        </div>\n      </div>\n    </article>\n  );\n}\n"
    }
