    instruction: "Pass onBack prop to apps and add animations to Landing"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport StudentApp from \'./student/StudentApp\';\nimport VendorApp from \'./vendor/VendorApp\';\nimport { Store, GraduationCap } from \'lucide-react\';\n\nexport default function App() {\n  const [appMode, setAppMode] = useState<\'LANDING\' | \'STUDENT\' | \'VENDOR\'>(\'LANDING\');\n\n  if (appMode === \'STUDENT\') {\n    return <StudentApp />;\n  }\n\n  if (appMode === \'VENDOR\') {\n    return <VendorApp />;\n  }\n\n  return (\n    <div className=\"min-h-screen bg-[#FFF8F6] text-[#111827] font-sans flex flex-col items-center justify-center p-6\">\n      <div className=\"max-w-md w-full bg-white rounded-3xl p-8 shadow-xl border border-[#F3F4F6] text-center space-y-8\">\n        <div>\n          <h1 className=\"font-display font-extrabold text-4xl text-[#FF6B00] mb-3 tracking-tight\">DealPlate</h1>\n          <p className=\"text-[#5a4136] text-sm leading-relaxed\">\n            Welcome to DealPlate. Are you looking to score amazing flash deals as a student, or manage surplus inventory as a vendor?\n          </p>\n        </div>\n\n        <div className=\"space-y-4\">\n          <button\n            onClick={() => setAppMode(\'STUDENT\')}\n            className=\"w-full flex items-center gap-4 bg-[#FF6B00]/10 hover:bg-[#FF6B00]/20 border border-[#FF6B00]/20 p-5 rounded-2xl transition-all active:scale-95 group\"\n          >\n            <div className=\"w-14 h-14 bg-white rounded-full flex items-center justify-center text-[#FF6B00] shadow-sm group-hover:scale-110 transition-transform\">\n              <GraduationCap className=\"w-7 h-7\" />\n            </div>\n            <div className=\"text-left\">\n              <span className=\"block font-display font-bold text-lg text-[#111827]\">Student Portal</span>\n              <span className=\"text-sm text-[#5a4136]\">Find & claim deals</span>\n            </div>\n          </button>\n\n          <button\n            onClick={() => setAppMode(\'VENDOR\')}\n            className=\"w-full flex items-center gap-4 bg-white hover:bg-gray-50 border border-gray-200 p-5 rounded-2xl transition-all active:scale-95 shadow-sm group\"\n          >\n            <div className=\"w-14 h-14 bg-gray-100 rounded-full flex items-center justify-center text-[#5a4136] shadow-inner group-hover:scale-110 transition-transform\">\n              <Store className=\"w-6 h-6\" />\n            </div>\n            <div className=\"text-left\">\n              <span className=\"block font-display font-bold text-lg text-[#111827]\">Vendor Portal</span>\n              <span className=\"text-sm text-[#5a4136]\">Manage inventory</span>\n            </div>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}"
        replacement_content: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport StudentApp from \'./student/StudentApp\';\nimport VendorApp from \'./vendor/VendorApp\';\nimport { Store, GraduationCap } from \'lucide-react\';\n\nexport default function App() {\n  const [appMode, setAppMode] = useState<\'LANDING\' | \'STUDENT\' | \'VENDOR\'>(\'LANDING\');\n\n  return (\n    <AnimatePresence mode=\"wait\">\n      {appMode === \'STUDENT\' && (\n        <motion.div key=\"student\" initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} className=\"min-h-screen\">\n          <StudentApp onBack={() => setAppMode(\'LANDING\')} />\n        </motion.div>\n      )}\n      \n      {appMode === \'VENDOR\' && (\n        <motion.div key=\"vendor\" initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} className=\"min-h-screen\">\n          <VendorApp onBack={() => setAppMode(\'LANDING\')} />\n        </motion.div>\n      )}\n      \n      {appMode === \'LANDING\' && (\n        <motion.div \n          key=\"landing\"\n          initial={{ opacity: 0, scale: 0.95 }}\n          animate={{ opacity: 1, scale: 1 }}\n          exit={{ opacity: 0, scale: 0.95 }}\n          className=\"min-h-screen bg-[#FFF8F6] text-[#111827] font-sans flex flex-col items-center justify-center p-6 relative overflow-hidden\"\n        >\n          {/* Decorative background blobs */}\n          <div className=\"absolute top-0 left-0 w-64 h-64 bg-[#FF6B00]/10 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2\" />\n          <div className=\"absolute bottom-0 right-0 w-80 h-80 bg-[#E11D48]/10 rounded-full blur-3xl translate-x-1/3 translate-y-1/3\" />\n          \n          <div className=\"max-w-md w-full bg-white/80 backdrop-blur-xl rounded-3xl p-8 shadow-xl border border-[#F3F4F6] text-center space-y-8 relative z-10\">\n            <div>\n              <div className=\"w-20 h-20 bg-gradient-to-br from-[#FF6B00] to-[#E11D48] rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg shadow-[#FF6B00]/20 rotate-3\">\n                <Store className=\"w-10 h-10 text-white\" />\n              </div>\n              <h1 className=\"font-display font-extrabold text-4xl text-[#111827] mb-3 tracking-tight\">DealPlate</h1>\n              <p className=\"text-[#5a4136] text-sm leading-relaxed\">\n                Welcome to DealPlate. Are you looking to score amazing flash deals as a student, or manage surplus inventory as a vendor?\n              </p>\n            </div>\n\n            <div className=\"space-y-4\">\n              <button\n                onClick={() => setAppMode(\'STUDENT\')}\n                className=\"w-full flex items-center gap-4 bg-[#FF6B00]/10 hover:bg-[#FF6B00]/20 border border-[#FF6B00]/20 p-5 rounded-2xl transition-all active:scale-95 group\"\n              >\n                <div className=\"w-14 h-14 bg-white rounded-full flex items-center justify-center text-[#FF6B00] shadow-sm group-hover:scale-110 transition-transform\">\n                  <GraduationCap className=\"w-7 h-7\" />\n                </div>\n                <div className=\"text-left\">\n                  <span className=\"block font-display font-bold text-lg text-[#111827]\">Student Portal</span>\n                  <span className=\"text-sm text-[#5a4136]\">Find & claim deals</span>\n                </div>\n              </button>\n\n              <button\n                onClick={() => setAppMode(\'VENDOR\')}\n                className=\"w-full flex items-center gap-4 bg-white hover:bg-gray-50 border border-gray-200 p-5 rounded-2xl transition-all active:scale-95 shadow-sm group\"\n              >\n                <div className=\"w-14 h-14 bg-gray-100 rounded-full flex items-center justify-center text-[#5a4136] shadow-inner group-hover:scale-110 transition-transform\">\n                  <Store className=\"w-6 h-6\" />\n                </div>\n                <div className=\"text-left\">\n                  <span className=\"block font-display font-bold text-lg text-[#111827]\">Vendor Portal</span>\n                  <span className=\"text-sm text-[#5a4136]\">Manage inventory</span>\n                </div>\n              </button>\n            </div>\n          </div>\n        </motion.div>\n      )}\n    </AnimatePresence>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
