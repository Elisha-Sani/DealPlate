    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useMemo } from \'react\';\nimport { AnimatePresence, motion } from \'motion/react\';\nimport {\n  ArrowLeft,\n  Search,\n  MapPin,\n  Menu,\n  Smartphone,\n  Lock,\n  CheckCircle2,\n  Clock,\n  Store,\n  X,\n  Eye,\n  EyeOff,\n  User,\n  ReceiptText,\n  Compass,\n  HelpCircle,\n  TrendingDown,\n  Edit3,\n  Camera,\n  Info,\n  ShieldAlert,\n  Sparkles,\n  Ticket,\n  QrCode,\n  LogOut,\n  Percent,\n  Heart,\n  Share2,\n  ShoppingBag,\n  Calendar,\n  ChevronRight,\n  UserCheck\n} from \'lucide-react\';\n\nimport { Deal, Order, User as UserType, ViewType } from \'./types\';\nimport { mockDeals, mockPastOrders } from \'./data\';\nimport Price from \'./components/Price\';\nimport Timer from \'./components/Timer\';\nimport MpesaSimulator from \'./components/MpesaSimulator\';\nimport DealCard from \'./components/DealCard\';\n\nexport default function App() {\n  // Navigation & User session states\n  const [currentView, setCurrentView] = useState<ViewType>(\'SIGN_IN\');\n  const [selectedDeal, setSelectedDeal] = useState<Deal | null>(null);\n  const [cartDeal, setCartDeal] = useState<Deal | null>(null);\n\n  // Active User session (prefilled with Alex Mercer\'s details for instant testability)\n  const [user, setUser] = useState<UserType>({\n    fullName: \'Alex Mercer\',\n    phone: \'+254 712 345 678\',\n    email: \'alex.mercer@student.uonbi.ac.ke\',\n    university: \'Technical University of Kenya\',\n    regNumber: \'SCCI/00586/2020\',\n    isVerified: true,\n    avatar: \'https://lh3.googleusercontent.com/aida-public/AB6AXuCvM9To3E1snhhIaUyvYK--vVdgJPDYXEXqt3wlV-t24DuJWjJD0btsklmPbN4ahTRJpUzp51b_fa68_qXZeSgMlX7EdPkqCq4y4c0rlR_f2T1xKqhkpSCXcPmiC69WrdAnm7U0mHrl3hItLZHLCAXtJBhZ9Bm57r-CNs2znXGoymmEJzcqikWqzIRqDGuYGUi1bQlFr39ED3hPpU2z-mZ-_YQhRetaWZw9QyPPXF1_c4Wl0nhfRmC5zFQ0z4e97wpOvgWv2ehl6H8\',\n    totalSaved: 4500,\n    mealsEnjoyed: 12\n  });\n\n  // Database of deals & past orders\n  const [deals, setDeals] = useState<Deal[]>(mockDeals);\n  const [pastOrders, setPastOrders] = useState<Order[]>(mockPastOrders);\n\n  // Marketplace filter states\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [selectedCampus, setSelectedCampus] = useState(\'all\');\n\n  // Security toggles\n  const [showPassword, setShowPassword] = useState(false);\n\n  // Checkout flow state (simulated M-Pesa push)\n  const [mpesaPhoneInput, setMpesaPhoneInput] = useState(\'712 345 678\');\n  const [isPaying, setIsPaying] = useState(false);\n  const [activeOrder, setActiveOrder] = useState<Order | null>(null);\n\n  // Active Ticket countdown duration (15:00 minutes = 900 seconds)\n  const [ticketSeconds, setTicketSeconds] = useState(900);\n\n  // Multi-step Registration Forms State\n  const [signUpForm, setSignUpForm] = useState({\n    fullName: \'\',\n    phone: \'\',\n    email: \'\',\n    password: \'\'\n  });\n  const [verifyForm, setVerifyForm] = useState({\n    university: \'Technical University of Kenya\',\n    regNumber: \'\'\n  });\n  const [idUploaded, setIdUploaded] = useState(false);\n  const [uploadError, setUploadError] = useState(\'\');\n\n  // Form error states\n  const [signUpError, setSignUpError] = useState(\'\');\n  const [verifyError, setVerifyError] = useState(\'\');\n\n  // Auto Tick down active ticket if any exists\n  useEffect(() => {\n    if (activeOrder && ticketSeconds > 0) {\n      const interval = setInterval(() => {\n        setTicketSeconds((prev) => {\n          if (prev <= 1) {\n            clearInterval(interval);\n            return 0;\n          }\n          return prev - 1;\n        });\n      }, 1000);\n      return () => clearInterval(interval);\n    }\n  }, [activeOrder, ticketSeconds]);\n\n  // Compute filtered deals based on search and selected campus\n  const filteredDeals = useMemo(() => {\n    return deals.filter((deal) => {\n      const matchesSearch =\n        deal.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        deal.vendor.toLowerCase().includes(searchQuery.toLowerCase()) ||\n        deal.category.toLowerCase().includes(searchQuery.toLowerCase());\n\n      const matchesCampus =\n        selectedCampus === \'all\' ||\n        deal.campus.toLowerCase() === selectedCampus.toLowerCase();\n\n      return matchesSearch && matchesCampus;\n    });\n  }, [deals, searchQuery, selectedCampus]);\n\n  // Handle M-Pesa payment simulator completion\n  const handlePaymentSuccess = () => {\n    setIsPaying(false);\n    if (!cartDeal) return;\n\n    // Save the new active order\n    const newOrder: Order = {\n      id: `order-dp-${Math.floor(100000 + Math.random() * 900000)}`,\n      deal: cartDeal,\n      date: new Date().toLocaleDateString(\'en-US\', { month: \'short\', day: \'numeric\', year: \'numeric\' }),\n      time: new Date().toLocaleTimeString(\'en-US\', { hour: \'numeric\', minute: \'2-digit\' }),\n      status: \'Active\',\n      totalPaid: cartDeal.dealPrice + 20, // include 20 service fee\n      pickupCode: `DP-${Math.floor(100000 + Math.random() * 900000).toString(36).toUpperCase().substring(0, 5)}`\n    };\n\n    setActiveOrder(newOrder);\n    setPastOrders([newOrder, ...pastOrders]);\n    setTicketSeconds(900); // 15:00 minutes ticket limit\n    \n    // Update user statistics\n    setUser(prev => ({\n      ...prev,\n      mealsEnjoyed: prev.mealsEnjoyed + 1,\n      totalSaved: prev.totalSaved + (cartDeal.originalPrice - cartDeal.dealPrice)\n    }));\n\n    setCurrentView(\'ORDER_CONFIRMED\');\n    setCartDeal(null);\n  };\n\n  // Sign In submit handler\n  const handleSignIn = (e: React.FormEvent) => {\n    e.preventDefault();\n    // In a prototype we allow instant sign-in. Prefill details\n    setUser({\n      fullName: \'Alex Mercer\',\n      phone: \'+254 712 345 678\',\n      email: \'alex.mercer@student.uonbi.ac.ke\',\n      university: \'Technical University of Kenya\',\n      regNumber: \'SCCI/00586/2020\',\n      isVerified: true,\n      avatar: \'https://lh3.googleusercontent.com/aida-public/AB6AXuCvM9To3E1snhhIaUyvYK--vVdgJPDYXEXqt3wlV-t24DuJWjJD0btsklmPbN4ahTRJpUzp51b_fa68_qXZeSgMlX7EdPkqCq4y4c0rlR_f2T1xKqhkpSCXcPmiC69WrdAnm7U0mHrl3hItLZHLCAXtJBhZ9Bm57r-CNs2znXGoymmEJzcqikWqzIRqDGuYGUi1bQlFr39ED3hPpU2z-mZ-_YQhRetaWZw9QyPPXF1_c4Wl0nhfRmC5zFQ0z4e97wpOvgWv2ehl6H8\',\n      totalSaved: 4500,\n      mealsEnjoyed: 12\n    });\n    setCurrentView(\'EXPLORE\');\n  };\n\n  // Step 1: Sign up submit\n  const handleSignUpSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!signUpForm.fullName || !signUpForm.phone || !signUpForm.email || !signUpForm.password) {\n      setSignUpError(\'Please fill in all details to snag deals.\');\n      return;\n    }\n    setSignUpError(\'\');\n    setCurrentView(\'VERIFY_STATUS\');\n  };\n\n  // Step 2: Verify status submit\n  const handleVerifySubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!verifyForm.regNumber) {\n      setVerifyError(\'Please enter your Student Registration Number.\');\n      return;\n    }\n    setVerifyError(\'\');\n    setCurrentView(\'UPLOAD_ID\');\n  };\n\n  // Step 3: Upload ID submit\n  const handleUploadSubmit = () => {\n    if (!idUploaded) {\n      setUploadError(\'Please click the upload card or drag-drop to upload your student ID.\');\n      return;\n    }\n    setUploadError(\'\');\n\n    // Complete registration\n    setUser({\n      fullName: signUpForm.fullName || \'Alex Mercer\',\n      phone: signUpForm.phone.startsWith(\'+254\') ? signUpForm.phone : `+254 ${signUpForm.phone}`,\n      email: signUpForm.email,\n      university: verifyForm.university,\n      regNumber: verifyForm.regNumber,\n      isVerified: true,\n      avatar: \'https://lh3.googleusercontent.com/aida-public/AB6AXuCvM9To3E1snhhIaUyvYK--vVdgJPDYXEXqt3wlV-t24DuJWjJD0btsklmPbN4ahTRJpUzp51b_fa68_qXZeSgMlX7EdPkqCq4y4c0rlR_f2T1xKqhkpSCXcPmiC69WrdAnm7U0mHrl3hItLZHLCAXtJBhZ9Bm57r-CNs2znXGoymmEJzcqikWqzIRqDGuYGUi1bQlFr39ED3hPpU2z-mZ-_YQhRetaWZw9QyPPXF1_c4Wl0nhfRmC5zFQ0z4e97wpOvgWv2ehl6H8\',\n      totalSaved: 0,\n      mealsEnjoyed: 0\n    });\n    setCurrentView(\'EXPLORE\');\n  };\n\n  // Quick reserve from deal card\n  const handleQuickReserve = (deal: Deal, e: React.MouseEvent) => {\n    e.stopPropagation();\n    setCartDeal(deal);\n    setCurrentView(\'CHECKOUT\');\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#FFF8F6] text-[#111827] font-sans flex flex-col antialiased select-none relative overflow-x-hidden\">\n      \n      {/* Transactional TopAppBar Shell */}\n      <header className=\"sticky top-0 bg-white/95 backdrop-blur-md z-40 border-b border-[#F3F4F6] shadow-sm\">\n        <div className=\"max-w-7xl mx-auto px-4 h-16 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            {/* Context Back navigation */}\n            {currentView !== \'SIGN_IN\' && currentView !== \'EXPLORE\' && (\n              <button\n                onClick={() => {\n                  if (currentView === \'SIGN_UP\') setCurrentView(\'SIGN_IN\');\n                  else if (currentView === \'VERIFY_STATUS\') setCurrentView(\'SIGN_UP\');\n                  else if (currentView === \'UPLOAD_ID\') setCurrentView(\'VERIFY_STATUS\');\n                  else if (currentView === \'DEAL_DETAILS\') {\n                    setCurrentView(\'EXPLORE\');\n                    setSelectedDeal(null);\n                  }\n                  else if (currentView === \'CHECKOUT\') {\n                    if (selectedDeal) setCurrentView(\'DEAL_DETAILS\');\n                    else setCurrentView(\'EXPLORE\');\n                    setCartDeal(null);\n                  }\n                  else if (currentView === \'ORDER_CONFIRMED\') {\n                    setCurrentView(\'EXPLORE\');\n                  }\n                  else if (currentView === \'PROFILE\') {\n                    setCurrentView(\'EXPLORE\');\n                  }\n                }}\n                className=\"w-10 h-10 -ml-2 rounded-full flex items-center justify-center text-[#FF6B00] hover:bg-[#F3F4F6] transition-colors active:scale-90\"\n                aria-label=\"Back\"\n              >\n                <ArrowLeft className=\"w-5 h-5\" />\n              </button>\n            )}\n            <h1 className=\"font-display font-extrabold text-2xl tracking-tight text-[#FF6B00]\">\n              DealPlate\n            </h1>\n          </div>\n\n          {/* Right Header Controls */}\n          <div className=\"flex items-center gap-3\">\n            {currentView === \'EXPLORE\' && (\n              <button \n                onClick={() => setCurrentView(\'PROFILE\')}\n                className=\"flex items-center gap-2 border border-[#F3F4F6] hover:border-[#FF6B00] bg-white rounded-full p-1 pr-3 shadow-sm hover:shadow transition-all text-xs font-semibold text-[#111827] active:scale-95 duration-100\"\n              >\n                <img\n                  className=\"w-7 h-7 rounded-full object-cover border border-outline-variant\"\n                  src={user.avatar}\n                  alt={user.fullName}\n                />\n                <span className=\"hidden sm:inline\">{user.fullName.split(\' \')[0]}</span>\n              </button>\n            )}\n            \n            {/* Quick Verification badge */}\n            {user.isVerified && currentView !== \'SIGN_IN\' && currentView !== \'SIGN_UP\' && (\n              <div className=\"hidden md:flex items-center gap-1.5 bg-[#FF6B00]/10 text-[#FF6B00] px-3 py-1 rounded-full text-xs font-bold shadow-sm\">\n                <UserCheck className=\"w-3.5 h-3.5\" />\n                <span>Verified student</span>\n              </div>\n            )}\n          </div>\n        </div>\n      </header>\n\n      {/* Main Container Layout */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto p-4 pb-28 md:pb-8 flex flex-col justify-start\">\n        \n        <AnimatePresence mode=\"wait\">\n          \n          {/* VIEW: SIGN IN */}\n          {currentView === \'SIGN_IN\' && (\n            <motion.div\n              key=\"signin\"\n              initial={{ opacity: 0, y: 15 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -15 }}\n              className=\"max-w-[420px] w-full mx-auto my-auto py-8\"\n            >\n              <div className=\"text-center mb-10\">\n                <div className=\"inline-flex p-4 rounded-full bg-[#FF6B00]/10 mb-4 text-[#FF6B00]\">\n                  <Sparkles className=\"w-8 h-8 animate-pulse\" />\n                </div>\n                <h2 className=\"font-display font-extrabold text-3xl tracking-tight text-[#111827] mb-2\">\n                  Welcome Back\n                </h2>\n                <p className=\"text-[#5a4136] text-sm max-w-xs mx-auto\">\n                  Sign in to snag today\'s flash meals in Nairobi before they are gone.\n                </p>\n              </div>\n\n              <form onSubmit={handleSignIn} className=\"bg-white rounded-2xl border border-[#F3F4F6] p-6 shadow-md space-y-5\">\n                <div>\n                  <label className=\"block text-xs font-bold text-[#5a4136] uppercase tracking-wider mb-2 ml-2\">\n                    Phone Number or Email\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    placeholder=\"student@university.edu or +254...\"\n                    className=\"w-full h-12 rounded-lg border border-gray-200 bg-white px-4 text-sm focus:ring-2 focus:ring-[#FF6B00] focus:border-transparent outline-none transition-all\"\n                  />\n                </div>\n\n                <div>\n                  <div className=\"flex justify-between items-center mb-2\">\n                    <label className=\"block text-xs font-bold text-[#5a4136] uppercase tracking-wider ml-2\">\n                      Password\n                    </label>\n                    <button type=\"button\" className=\"text-xs text-[#E11D48] font-bold hover:underline\">\n                      Forgot?\n                    </button>\n                  </div>\n                  <div className=\"relative\">\n                    <input\n                      type={showPassword ? \'text\' : \'password\'}\n                      required\n                      placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                      className=\"w-full h-12 rounded-lg border border-gray-200 bg-white pl-4 pr-11 text-sm focus:ring-2 focus:ring-[#FF6B00] focus:border-transparent outline-none transition-all\"\n                    />\n                    <button\n                      type=\"button\"\n                      onClick={() => setShowPassword(!showPassword)}\n                      className=\"absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-[#FF6B00] transition-colors\"\n                    >\n                      {showPassword ? <EyeOff className=\"w-5 h-5\" /> : <Eye className=\"w-5 h-5\" />}\n                    </button>\n                  </div>\n                </div>\n\n                <button\n                  type=\"submit\"\n                  className=\"w-full h-12 bg-[#FF6B00] text-white rounded-lg font-bold hover:bg-[#e66000] active:scale-95 transition-all shadow-md flex items-center justify-center gap-2 mt-2\"\n                >\n                  <Lock className=\"w-4 h-4\" />\n                  <span>Secure Login</span>\n                </button>\n              </form>\n\n              <div className=\"mt-8 text-center\">\n                <p className=\"text-sm text-[#5a4136] mb-3\">New to DealPlate?</p>\n                <button\n                  onClick={() => setCurrentView(\'SIGN_UP\')}\n                  className=\"border border-[#FF6B00] text-[#FF6B00] hover:bg-[#FF6B00]/5 px-8 h-12 rounded-lg font-bold active:scale-95 transition-all shadow-sm bg-white\"\n                >\n                  Create Student Account\n                </button>\n              </div>\n            </motion.div>\n          )}\n\n          {/* VIEW: SIGN UP (Step 1 of Register) */}\n          {currentView === \'SIGN_UP\' && (\n            <motion.div\n              key=\"signup\"\n              initial={{ opacity: 0, x: 15 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: -15 }}\n              className=\"max-w-[420px] w-full mx-auto py-6\"\n            >\n              <div className=\"text-center mb-8\">\n                <h2 className=\"font-display font-extrabold text-3xl tracking-tight text-[#111827] mb-2\">\n                  Join DealPlate\n                </h2>\n                <p className=\"text-[#5a4136] text-sm\">\n                  Get exclusive student flash deals on local meals.\n                </p>\n              </div>\n\n              <div className=\"bg-white rounded-2xl border border-[#F3F4F6] p-6 shadow-md\">\n                {signUpError && (\n                  <div className=\"mb-4 bg-red-50 text-red-600 p-3 rounded-lg text-xs font-semibold flex items-center gap-2\">\n                    <ShieldAlert className=\"w-4 h-4 shrink-0\" />\n                    <span>{signUpError}</span>\n                  </div>\n                )}\n\n                <form onSubmit={handleSignUpSubmit} className=\"space-y-4\">\n                  <div>\n                    <label className=\"block text-xs font-bold text-[#5a4136] uppercase tracking-wider mb-1.5 ml-2\">\n                      Full Name\n                    </label>\n                    <input\n                      type=\"text\"\n                      placeholder=\"Jane Doe\"\n                      value={signUpForm.fullName}\n                      onChange={(e) => setSignUpForm({ ...signUpForm, fullName: e.target.value })}\n                      className=\"w-full h-12 rounded-lg border border-gray-200 bg-white px-4 text-sm focus:ring-2 focus:ring-[#FF6B00] outline-none transition-all\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-bold text-[#5a4136] uppercase tracking-wider mb-1.5 ml-2\">\n                      Phone Number (M-Pesa)\n                    </label>\n                    <input\n                      type=\"tel\"\n                      placeholder=\"+254 7XX XXX XXX\"\n                      value={signUpForm.phone}\n                      onChange={(e) => setSignUpForm({ ...signUpForm, phone: e.target.value })}\n                      className=\"w-full h-12 rounded-lg border border-gray-200 bg-white px-4 text-sm focus:ring-2 focus:ring-[#FF6B00] outline-none transition-all\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-bold text-[#5a4136] uppercase tracking-wider mb-1.5 ml-2\">\n                      University Email\n                    </label>\n                    <input\n                      type=\"email\"\n                      placeholder=\"student@university.edu\"\n                      value={signUpForm.email}\n                      onChange={(e) => setSignUpForm({ ...signUpForm, email: e.target.value })}\n                      className=\"w-full h-12 rounded-lg border border-gray-200 bg-white px-4 text-sm focus:ring-2 focus:ring-[#FF6B00] outline-none transition-all\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-bold text-[#5a4136] uppercase tracking-wider mb-1.5 ml-2\">\n                      Password\n                    </label>\n                    <input\n                      type=\"password\"\n                      placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                      value={signUpForm.password}\n                      onChange={(e) => setSignUpForm({ ...signUpForm, password: e.target.value })}\n                      className=\"w-full h-12 rounded-lg border border-gray-200 bg-white px-4 text-sm focus:ring-2 focus:ring-[#FF6B00] outline-none transition-all\"\n                    />\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    className=\"w-full h-12 bg-[#FF6B00] text-white rounded-lg font-bold hover:bg-[#e66000] active:scale-95 transition-all shadow-md flex items-center justify-center gap-2 mt-4\"\n                  >\n                    <span>Next: Verify Student Status</span>\n                  </button>\n                </form>\n              </div>\n\n              <div className=\"mt-6 text-center\">\n                <button\n                  onClick={() => setCurrentView(\'SIGN_IN\')}\n                  className=\"text-xs font-bold text-[#FF6B00] hover:underline\"\n                >\n                  Already have an account? Sign In\n                </button>\n              </div>\n            </motion.div>\n          )}\n\n          {/* VIEW: VERIFY STATUS (Step 1 of Academic verification) */}\n          {currentView === \'VERIFY_STATUS\' && (\n            <motion.div\n              key=\"verify-status\"\n              initial={{ opacity: 0, x: 15 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: -15 }}\n              className=\"max-w-[420px] w-full mx-auto py-4\"\n            >\n              {/* Step indicator */}\n              <div className=\"w-full mb-8\">\n                <div className=\"flex justify-between items-end mb-2\">\n                  <span className=\"text-xs font-bold text-[#FF6B00] uppercase tracking-wider\">Step 1 of 2</span>\n                  <span className=\"text-xs font-semibold text-[#5a4136]\">Academic Details</span>\n                </div>\n                <div className=\"w-full bg-gray-200 rounded-full h-1.5 overflow-hidden\">\n                  <div className=\"bg-[#FF6B00] h-full rounded-full w-1/2 transition-all duration-500 shadow-sm\" />\n                </div>\n              </div>\n\n              <div className=\"text-center mb-8\">\n                <div className=\"inline-flex items-center justify-center w-14 h-14 rounded-full bg-[#FF6B00]/10 text-[#FF6B00] mb-3\">\n                  <Sparkles className=\"w-6 h-6\" />\n                </div>\n                <h2 className=\"font-display font-extrabold text-2xl tracking-tight text-[#111827] mb-2\">\n                  Verify Your Status\n                </h2>\n                <p className=\"text-[#5a4136] text-sm\">\n                  Exclusive deals are for verified students only. Tell us your campus.\n                </p>\n              </div>\n\n              <div className=\"bg-white rounded-2xl border border-[#F3F4F6] p-6 shadow-md\">\n                {verifyError && (\n                  <div className=\"mb-4 bg-red-50 text-red-600 p-3 rounded-lg text-xs font-semibold flex items-center gap-2\">\n                    <ShieldAlert className=\"w-4 h-4 shrink-0\" />\n                    <span>{verifyError}</span>\n                  </div>\n                )}\n\n                <form onSubmit={handleVerifySubmit} className=\"space-y-5\">\n                  <div>\n                    <label className=\"block text-xs font-bold text-[#5a4136] uppercase tracking-wider mb-2 ml-2\">\n                      University / Institution\n                    </label>\n                    <select\n                      value={verifyForm.university}\n                      onChange={(e) => setVerifyForm({ ...verifyForm, university: e.target.value })}\n                      className=\"w-full h-12 rounded-lg border border-gray-200 bg-white px-3 text-sm focus:ring-2 focus:ring-[#FF6B00] outline-none transition-all\"\n                    >\n                      <option value=\"Technical University of Kenya\">Technical University of Kenya</option>\n                      <option value=\"University of Nairobi\">University of Nairobi</option>\n                      <option value=\"Kenyatta University\">Kenyatta University</option>\n                      <option value=\"Jomo Kenyatta University (JKUAT)\">JKUAT</option>\n                      <option value=\"Strathmore University\">Strathmore University</option>\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-bold text-[#5a4136] uppercase tracking-wider mb-1.5 ml-2\">\n                      Student Registration Number\n                    </label>\n                    <input\n                      type=\"text\"\n                      placeholder=\"SCCI/00586/2020\"\n                      value={verifyForm.regNumber}\n                      onChange={(e) => setVerifyForm({ ...verifyForm, regNumber: e.target.value })}\n                      className=\"w-full h-12 rounded-lg border border-gray-200 bg-white px-4 text-sm focus:ring-2 focus:ring-[#FF6B00] outline-none transition-all uppercase\"\n                    />\n                    <p className=\"mt-2 text-xs text-gray-400 ml-2 flex items-center gap-1\">\n                      <Info className=\"w-3.5 h-3.5 text-[#FF6B00]\" />\n                      Found on your official student ID card.\n                    </p>\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    className=\"w-full h-12 bg-[#FF6B00] text-white rounded-lg font-bold hover:bg-[#e66000] active:scale-95 transition-all shadow-md flex items-center justify-center gap-2 mt-4\"\n                  >\n                    <span>Continue</span>\n                    <ChevronRight className=\"w-4 h-4\" />\n                  </button>\n                </form>\n              </div>\n            </motion.div>\n          )}\n\n          {/* VIEW: UPLOAD ID (Step 2 of Academic verification) */}\n          {currentView === \'UPLOAD_ID\' && (\n            <motion.div\n              key=\"upload-id\"\n              initial={{ opacity: 0, x: 15 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: -15 }}\n              className=\"max-w-[420px] w-full mx-auto py-4\"\n            >\n              {/* Step indicator */}\n              <div className=\"w-full mb-8\">\n                <div className=\"flex justify-between items-end mb-2\">\n                  <span className=\"text-xs font-bold text-[#FF6B00] uppercase tracking-wider\">Step 2 of 2</span>\n                  <span className=\"text-xs font-semibold text-[#5a4136]\">Academic Details</span>\n                </div>\n                <div className=\"w-full bg-gray-200 rounded-full h-1.5 overflow-hidden\">\n                  <div className=\"bg-[#FF6B00] h-full rounded-full w-full transition-all duration-500 shadow-sm\" />\n                </div>\n              </div>\n\n              <div className=\"text-center mb-8\">\n                <h2 className=\"font-display font-extrabold text-2xl tracking-tight text-[#111827] mb-2 animate-pulse\">\n                  Upload Student ID\n                </h2>\n                <p className=\"text-[#5a4136] text-sm max-w-sm mx-auto\">\n                  Take a clear photo of your current student ID card. Ensure name, photo, and valid dates are visible.\n                </p>\n              </div>\n\n              <div className=\"bg-white rounded-2xl border border-[#F3F4F6] p-6 shadow-md flex flex-col\">\n                {uploadError && (\n                  <div className=\"mb-4 bg-red-50 text-red-600 p-3 rounded-lg text-xs font-semibold flex items-center gap-2\">\n                    <ShieldAlert className=\"w-4 h-4\" />\n                    <span>{uploadError}</span>\n                  </div>\n                )}\n\n                {/* ID upload drop box */}\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setIdUploaded(true);\n                    setUploadError(\'\');\n                  }}\n                  className={`w-full border-2 border-dashed rounded-xl flex flex-col items-center justify-center p-8 gap-4 mb-5 transition-all active:scale-95 ${\n                    idUploaded\n                      ? \'border-green-500 bg-green-50/30\'\n                      : \'border-[#FF6B00]/60 bg-[#FF6B00]/5 hover:bg-[#FF6B00]/10\'\n                  }`}\n                >\n                  <div className={`w-14 h-14 rounded-full flex items-center justify-center ${\n                    idUploaded ? \'bg-green-500 text-white\' : \'bg-[#FF6B00]/10 text-[#FF6B00]\'\n                  }`}>\n                    <Camera className=\"w-6 h-6 animate-pulse\" />\n                  </div>\n                  <div>\n                    <span className=\"block text-sm font-bold text-[#111827]\">\n                      {idUploaded ? \'ID Photo Selected\' : \'Upload Valid Student ID Photo\'}\n                    </span>\n                    <span className=\"text-xs text-gray-400 block mt-1\">\n                      {idUploaded ? \'ID_Alex_Mercer_UoN.jpg (420kb)\' : \'Supports JPEG, PNG up to 5MB\'}\n                    </span>\n                  </div>\n                </button>\n\n                {/* Secure badge details */}\n                <div className=\"bg-[#F3F4F6] rounded-xl p-4 flex gap-3 border border-gray-100\">\n                  <div className=\"text-[#FF6B00] shrink-0 mt-0.5\">\n                    <UserCheck className=\"w-5 h-5\" />\n                  </div>\n                  <p className=\"text-xs text-[#5a4136] leading-relaxed\">\n                    <strong>Access strictly limited:</strong> Information is only utilized to verify enrollment status before unlock code generation. Secure encryption is applied.\n                  </p>\n                </div>\n\n                <button\n                  type=\"button\"\n                  onClick={handleUploadSubmit}\n                  className=\"w-full h-12 bg-[#FF6B00] text-white rounded-lg font-bold hover:bg-[#e66000] active:scale-95 transition-all shadow-md mt-6 flex items-center justify-center gap-2\"\n                >\n                  <span>Submit Application</span>\n                </button>\n              </div>\n            </motion.div>\n          )}\n\n          {/* VIEW: EXPLORE MARKETPLACE (DEAL FEED) */}\n          {currentView === \'EXPLORE\' && (\n            <motion.div\n              key=\"explore\"\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"w-full flex flex-col gap-6\"\n            >\n              {/* Promo Banner */}\n              <div className=\"w-full bg-gradient-to-r from-[#FF6B00] to-[#E11D48] rounded-2xl p-6 text-white shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n                <div className=\"space-y-1\">\n                  <span className=\"bg-white/20 text-white text-xs font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider\">\n                    High-Velocity Alert\n                  </span>\n                  <h2 className=\"text-2xl font-display font-extrabold tracking-tight\">\n                    Nairobi Campus Flash Deals Are Live!\n                  </h2>\n                  <p className=\"text-white/80 text-sm\">\n                    Up to 70% off artisan pizzas, fresh sushi, burgers, and pastries for verified students.\n                  </p>\n                </div>\n                <div className=\"text-white bg-black/15 backdrop-blur-md px-4 py-3 rounded-xl border border-white/10 shrink-0 text-center\">\n                  <span className=\"block text-xs uppercase tracking-wider opacity-85\">Daily Saved Amount</span>\n                  <Price amount={user.totalSaved} size=\"lg\" className=\"text-white font-black\" />\n                </div>\n              </div>\n\n              {/* Search & Location filtering bar */}\n              <div className=\"flex flex-col sm:flex-row gap-3 items-center bg-white p-4 rounded-xl shadow-sm border border-[#F3F4F6] w-full\">\n                \n                {/* Search query field */}\n                <div className=\"relative flex-1 w-full\">\n                  <Search className=\"absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5\" />\n                  <input\n                    type=\"text\"\n                    value={searchQuery}\n                    onChange={(e) => setSearchQuery(e.target.value)}\n                    placeholder=\"Search sushi, pizza, burgers, bakeries...\"\n                    className=\"w-full h-12 pl-11 pr-4 rounded-lg bg-[#F3F4F6] border-none text-sm text-[#111827] placeholder-gray-400 focus:ring-2 focus:ring-[#FF6B00] outline-none transition-all font-sans\"\n                  />\n                  {searchQuery && (\n                    <button\n                      onClick={() => setSearchQuery(\'\')}\n                      className=\"absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-[#FF6B00]\"\n                    >\n                      <X className=\"w-5 h-5\" />\n                    </button>\n                  )}\n                </div>\n\n                {/* Dropdown filter */}\n                <div className=\"relative min-w-[200px] w-full sm:w-auto\">\n                  <MapPin className=\"absolute left-3.5 top-1/2 -translate-y-1/2 text-[#FF6B00] w-4 h-4 pointer-events-none\" />\n                  <select\n                    value={selectedCampus}\n                    onChange={(e) => setSelectedCampus(e.target.value)}\n                    className=\"w-full h-12 pl-10 pr-10 rounded-lg bg-[#F3F4F6] border-none text-sm text-[#111827] focus:ring-2 focus:ring-[#FF6B00] outline-none transition-all font-semibold appearance-none cursor-pointer\"\n                  >\n                    <option value=\"all\">All Campuses</option>\n                    <option value=\"Main Campus\">Main Campus</option>\n                    <option value=\"Lower Kabete\">Lower Kabete</option>\n                    <option value=\"Chiromo\">Chiromo</option>\n                  </select>\n                </div>\n              </div>\n\n              {/* Grid Content Layout */}\n              <div className=\"columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4\">\n                {filteredDeals.length > 0 ? (\n                  filteredDeals.map((deal) => (\n                    <DealCard\n                      key={deal.id}\n                      deal={deal}\n                      onSelect={(d) => {\n                        setSelectedDeal(d);\n                        setCurrentView(\'DEAL_DETAILS\');\n                      }}\n                      onQuickReserve={handleQuickReserve}\n                    />\n                  ))\n                ) : (\n                  <div className=\"col-span-full py-16 text-center max-w-md mx-auto\">\n                    <div className=\"inline-flex p-4 rounded-full bg-orange-50 text-[#FF6B00] mb-4\">\n                      <ShieldAlert className=\"w-8 h-8\" />\n                    </div>\n                    <h3 className=\"font-display font-extrabold text-xl text-[#111827] mb-1\">\n                      No High-Velocity Deals Found\n                    </h3>\n                    <p className=\"text-sm text-gray-400\">\n                      Try adjusting your campus location filter or typing a different keyword to find deals!\n                    </p>\n                  </div>\n                )}\n              </div>\n            </motion.div>\n          )}\n\n          {/* VIEW: DEAL DETAILS SCREEN */}\n          {currentView === \'DEAL_DETAILS\' && selectedDeal && (\n            <motion.div\n              key=\"deal-details\"\n              initial={{ opacity: 0, y: 15 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -15 }}\n              className=\"max-w-2xl w-full mx-auto flex flex-col gap-5\"\n            >\n              {/* Back Button and action */}\n              <div className=\"flex justify-between items-center\">\n                <button\n                  onClick={() => {\n                    setCurrentView(\'EXPLORE\');\n                    setSelectedDeal(null);\n                  }}\n                  className=\"inline-flex items-center gap-1 text-sm font-semibold text-[#FF6B00] hover:underline\"\n                >\n                  <ArrowLeft className=\"w-4 h-4\" />\n                  <span>Back to Feed</span>\n                </button>\n                <div className=\"flex gap-2\">\n                  <button className=\"w-10 h-10 bg-white border border-[#F3F4F6] rounded-full flex items-center justify-center text-gray-400 hover:text-[#E11D48] transition-colors shadow-sm\">\n                    <Heart className=\"w-5 h-5\" />\n                  </button>\n                  <button className=\"w-10 h-10 bg-white border border-[#F3F4F6] rounded-full flex items-center justify-center text-gray-400 hover:text-[#FF6B00] transition-colors shadow-sm\">\n                    <Share2 className=\"w-5 h-5\" />\n                  </button>\n                </div>\n              </div>\n\n              {/* Core visual panel layout */}\n              <div className=\"bg-white rounded-2xl border border-[#F3F4F6] overflow-hidden shadow-md\">\n                \n                {/* 16:9 Banner Image */}\n                <div className=\"relative aspect-video w-full bg-[#F3F4F6] overflow-hidden\">\n                  <img\n                    src={selectedDeal.image}\n                    alt={selectedDeal.title}\n                    className=\"w-full h-full object-cover\"\n                  />\n                  <div className=\"absolute top-4 left-4 bg-[#E11D48] text-white text-xs font-black px-3.5 py-1.5 rounded-full shadow-md\">\n                    {selectedDeal.discountPercentage}% SAVINGS\n                  </div>\n                </div>\n\n                {/* Info parameters */}\n                <div className=\"p-6 space-y-5\">\n                  <div className=\"flex flex-col md:flex-row md:items-start justify-between gap-4\">\n                    <div>\n                      <h2 className=\"font-display font-extrabold text-2xl tracking-tight text-[#111827] mb-2 leading-tight\">\n                        {selectedDeal.title}\n                      </h2>\n                      <div className=\"flex items-center gap-1.5 text-sm font-medium text-[#5a4136]\">\n                        <Store className=\"w-4 h-4 text-[#FF6B00]\" />\n                        <span>{selectedDeal.vendor} &bull; {selectedDeal.campus}</span>\n                      </div>\n                    </div>\n                    {/* Price Block */}\n                    <div className=\"flex items-end gap-2 bg-[#FFF8F6] px-4 py-2 rounded-xl border border-[#FF6B00]/10 w-fit shrink-0\">\n                      <div className=\"flex flex-col text-right\">\n                        <span className=\"text-xs text-gray-400 line-through\">Value Ksh {selectedDeal.originalPrice}</span>\n                        <Price amount={selectedDeal.dealPrice} size=\"xl\" className=\"text-[#FF6B00]\" />\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Badges/Tags category chips */}\n                  <div className=\"flex flex-wrap gap-2\">\n                    <span className=\"text-xs font-bold px-3 py-1 bg-[#FF6B00]/10 text-[#FF6B00] rounded-full uppercase tracking-wider\">\n                      {selectedDeal.category}\n                    </span>\n                    {selectedDeal.tags.map((t, idx) => (\n                      <span key={idx} className=\"text-xs font-bold px-3 py-1 bg-gray-100 text-[#5a4136] rounded-full\">\n                        {t}\n                      </span>\n                    ))}\n                  </div>\n\n                  {/* Urgency Progress Limit bar */}\n                  <div className=\"bg-[#E11D48]/5 border border-[#E11D48]/10 rounded-xl p-4 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-inner\">\n                    <div className=\"flex items-center gap-2\">\n                      <div className=\"w-2.5 h-2.5 rounded-full bg-[#E11D48] animate-ping\" />\n                      <span className=\"text-xs font-extrabold text-[#E11D48] uppercase tracking-wider\">\n                        Selling Fast! Only {selectedDeal.stockCount} meals left\n                      </span>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      <Clock className=\"w-4 h-4 text-[#FF6B00]\" />\n                      <span className=\"text-xs font-bold text-[#5a4136]\">Ends in 01:24:52</span>\n                    </div>\n                  </div>\n\n                  {/* Description Box */}\n                  <div className=\"space-y-2\">\n                    <h4 className=\"text-xs uppercase tracking-widest font-black text-[#5a4136] ml-1\">\n                      What to Expect\n                    </h4>\n                    <p className=\"bg-[#F3F4F6] text-sm text-[#111827] leading-relaxed p-4 rounded-xl border border-gray-100 font-sans\">\n                      {selectedDeal.description}\n                    </p>\n                  </div>\n\n                  {/* Pickup specifications */}\n                  <div className=\"space-y-3\">\n                    <h4 className=\"text-xs uppercase tracking-widest font-black text-[#5a4136] ml-1\">\n                      Pickup Specifications\n                    </h4>\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                      <div className=\"bg-white border border-gray-200 rounded-xl p-4 flex items-center gap-3\">\n                        <Clock className=\"w-5 h-5 text-[#FF6B00] shrink-0\" />\n                        <div>\n                          <span className=\"block text-xs text-gray-400 font-medium\">Pickup Timeframe</span>\n                          <span className=\"text-sm font-bold text-[#111827]\">{selectedDeal.timeStart} - {selectedDeal.timeEnd}</span>\n                        </div>\n                      </div>\n                      <div className=\"bg-white border border-gray-200 rounded-xl p-4 flex items-center gap-3\">\n                        <MapPin className=\"w-5 h-5 text-[#FF6B00] shrink-0\" />\n                        <div>\n                          <span className=\"block text-xs text-gray-400 font-medium\">Vendor Address</span>\n                          <span className=\"text-sm font-bold text-[#111827] truncate\">124 University Ave, Campus Gate</span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Action reserve button */}\n                  <button\n                    onClick={() => {\n                      setCartDeal(selectedDeal);\n                      setCurrentView(\'CHECKOUT\');\n                    }}\n                    className=\"w-full h-14 bg-[#FF6B00] hover:bg-[#e66000] text-white font-display font-extrabold text-base tracking-tight rounded-xl flex items-center justify-center gap-2 transition-transform active:scale-95 duration-100 shadow-md shadow-[#FF6B00]/20\"\n                  >\n                    <ShoppingBag className=\"w-5 h-5\" />\n                    <span>Reserve & Add to Cart</span>\n                  </button>\n                </div>\n              </div>\n            </motion.div>\n          )}\n\n          {/* VIEW: CHECKOUT SCREEN */}\n          {currentView === \'CHECKOUT\' && cartDeal && (\n            <motion.div\n              key=\"checkout\"\n              initial={{ opacity: 0, scale: 0.98 }}\n              animate={{ opacity: 1, scale: 1 }}\n              exit={{ opacity: 0, scale: 0.98 }}\n              className=\"max-w-2xl w-full mx-auto flex flex-col gap-5\"\n            >\n              <div>\n                <h2 className=\"font-display font-extrabold text-3xl tracking-tight text-[#111827] mb-1 leading-tight\">\n                  Checkout\n                </h2>\n                <p className=\"text-[#5a4136] text-sm\">\n                  Review your flash deal and trigger secure mobile payment.\n                </p>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-12 gap-5 items-start\">\n                \n                {/* Left Columns details */}\n                <div className=\"md:col-span-7 space-y-4\">\n                  \n                  {/* Item Description Card */}\n                  <div className=\"bg-white rounded-xl border border-[#F3F4F6] p-4 flex gap-4 items-center shadow-sm\">\n                    <div className=\"w-20 h-20 rounded-lg overflow-hidden shrink-0 relative bg-gray-100 border\">\n                      <img\n                        src={cartDeal.image}\n                        alt={cartDeal.title}\n                        className=\"w-full h-full object-cover\"\n                      />\n                      <div className=\"absolute top-0 left-0 bg-[#E11D48] text-white text-[10px] font-black px-2 py-0.5 rounded-br-lg\">\n                        -{cartDeal.discountPercentage}%\n                      </div>\n                    </div>\n                    <div className=\"flex-1 min-w-0\">\n                      <h3 className=\"font-display font-bold text-base text-[#111827] leading-tight truncate\">\n                        {cartDeal.title}\n                      </h3>\n                      <p className=\"text-xs text-gray-400 font-medium mt-1\">\n                        {cartDeal.vendor} &bull; Pickup in {cartDeal.timeStart}\n                      </p>\n                    </div>\n                    <Price amount={cartDeal.dealPrice} size=\"lg\" className=\"shrink-0\" />\n                  </div>\n\n                  {/* Payment Method Details */}\n                  <div className=\"bg-white rounded-xl border border-[#F3F4F6] p-5 shadow-sm space-y-4\">\n                    <div className=\"flex items-center gap-2 border-b border-gray-100 pb-3\">\n                      <Smartphone className=\"w-5 h-5 text-[#26B24B]\" />\n                      <h3 className=\"font-display font-extrabold text-base text-[#111827]\">\n                        Payment Method (M-Pesa)\n                      </h3>\n                    </div>\n\n                    <div>\n                      <label className=\"block text-xs font-bold text-[#5a4136] uppercase tracking-wider mb-2 ml-1\">\n                        M-Pesa Registered Number\n                      </label>\n                      <div className=\"relative\">\n                        <div className=\"absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none\">\n                          <span className=\"text-sm font-bold text-gray-400\">+254</span>\n                        </div>\n                        <input\n                          type=\"tel\"\n                          value={mpesaPhoneInput}\n                          onChange={(e) => setMpesaPhoneInput(e.target.value)}\n                          placeholder=\"7XX XXX XXX\"\n                          className=\"w-full h-12 pl-14 pr-4 rounded-lg bg-gray-50 border border-gray-200 text-sm text-[#111827] font-semibold outline-none focus:ring-2 focus:ring-[#FF6B00] transition-all\"\n                        />\n                      </div>\n                      <p className=\"text-[11px] text-gray-400 mt-2 ml-1\">\n                        We will dispatch an automated Safaricom Daraja STK Push prompt to this handset.\n                      </p>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Right Columns pricing block */}\n                <div className=\"md:col-span-5\">\n                  <div className=\"bg-white rounded-xl border border-[#F3F4F6] p-5 shadow-sm space-y-4 sticky top-24\">\n                    <h3 className=\"font-display font-extrabold text-base text-[#111827]\">\n                      Order Summary\n                    </h3>\n\n                    <div className=\"space-y-2 text-sm border-b border-gray-100 pb-3.5\">\n                      <div className=\"flex justify-between text-[#5a4136]\">\n                        <span>Flash Deal Price</span>\n                        <Price amount={cartDeal.dealPrice} size=\"sm\" />\n                      </div>\n                      <div className=\"flex justify-between text-[#5a4136]\">\n                        <span>Merchant Service Fee</span>\n                        <Price amount={20} size=\"sm\" />\n                      </div>\n                    </div>\n\n                    <div className=\"flex justify-between items-center py-2\">\n                      <span className=\"text-base font-bold text-[#111827]\">Grand Total</span>\n                      <Price amount={cartDeal.dealPrice + 20} size=\"xl\" className=\"text-[#FF6B00]\" />\n                    </div>\n\n                    <button\n                      type=\"button\"\n                      onClick={() => setIsPaying(true)}\n                      className=\"w-full h-12 bg-[#26B24B] hover:bg-[#209c40] text-white font-bold rounded-lg flex items-center justify-center gap-2 transition-transform active:scale-95 duration-100 shadow-md\"\n                    >\n                      <Lock className=\"w-4 h-4\" />\n                      <span>Pay Ksh {cartDeal.dealPrice + 20} with M-Pesa</span>\n                    </button>\n\n                    <p className=\"text-[10px] text-gray-400 leading-normal text-center pt-2\">\n                      Safaricom Daraja payment secures deal instantly. No cash accepted on pickup. Cancel anytime prior to dispatch.\n                    </p>\n                  </div>\n                </div>\n              </div>\n\n              {/* Paying overlay popover */}\n              {isPaying && (\n                <MpesaSimulator\n                  amount={cartDeal.dealPrice + 20}\n                  phoneNumber={`+254 ${mpesaPhoneInput}`}\n                  onSuccess={handlePaymentSuccess}\n                  onCancel={() => setIsPaying(false)}\n                />\n              )}\n            </motion.div>\n          )}\n\n          {/* VIEW: ORDER CONFIRMED SCREEN (ACTIVE TICKET) */}\n          {currentView === \'ORDER_CONFIRMED\' && activeOrder && (\n            <motion.div\n              key=\"confirmed\"\n              initial={{ opacity: 0, scale: 0.98 }}\n              animate={{ opacity: 1, scale: 1 }}\n              exit={{ opacity: 0, scale: 0.98 }}\n              className=\"max-w-md w-full mx-auto flex flex-col gap-5 py-2\"\n            >\n              <div className=\"text-center space-y-2\">\n                <div className=\"inline-flex items-center justify-center w-14 h-14 rounded-full bg-green-500 text-white shadow-md animate-bounce\">\n                  <CheckCircle2 className=\"w-7 h-7\" />\n                </div>\n                <h2 className=\"font-display font-black text-2xl tracking-tight text-[#111827]\">\n                  Order Confirmed!\n                </h2>\n                <p className=\"text-[#5a4136] text-sm leading-relaxed max-w-xs mx-auto\">\n                  Your flash meal deal has been secured at campus merchant gateway.\n                </p>\n              </div>\n\n              {/* Secure code block ticket */}\n              <div className=\"bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-lg flex flex-col\">\n                \n                {/* Visual code parameters */}\n                <div className=\"bg-[#FFF8F6] border-b border-dashed border-gray-200 p-6 flex flex-col items-center justify-center text-center\">\n                  <span className=\"text-xs uppercase tracking-widest font-black text-gray-400 mb-2\">PICKUP CODE</span>\n                  <div className=\"bg-white border-2 border-[#FF6B00] font-mono text-3xl font-black text-[#111827] px-6 py-3 rounded-xl tracking-widest mb-4 shadow-sm animate-pulse\">\n                    {activeOrder.pickupCode}\n                  </div>\n                  \n                  {/* Generated simulated QR Code */}\n                  <div className=\"p-3 bg-white border border-gray-100 rounded-xl shadow-inner mb-2\">\n                    <QrCode className=\"w-24 h-24 text-[#111827]\" />\n                  </div>\n                  <span className=\"text-xs font-semibold text-[#5a4136]\">Show this QR code to the cashier</span>\n                </div>\n\n                {/* Countdown pickup window box */}\n                <div className=\"p-6 space-y-4\">\n                  <div className=\"text-center\">\n                    <span className=\"text-xs uppercase tracking-widest font-black text-gray-400 mb-2 block\">\n                      PICKUP WINDOW LIMIT\n                    </span>\n                    <Timer initialSeconds={ticketSeconds} variant=\"box\" />\n                  </div>\n\n                  <p className=\"text-xs text-[#E11D48] text-center font-semibold bg-red-50 p-3 rounded-lg flex items-center gap-1.5 justify-center\">\n                    <ShieldAlert className=\"w-4 h-4\" />\n                    <span>Hurry! Your food might be released if window expires.</span>\n                  </p>\n\n                  <div className=\"border-t border-gray-100 pt-4 space-y-3\">\n                    <h4 className=\"text-xs uppercase tracking-widest font-black text-[#5a4136]\">\n                      Item details\n                    </h4>\n                    <div className=\"flex justify-between items-center text-sm\">\n                      <span className=\"text-[#5a4136] font-medium\">{activeOrder.deal.title}</span>\n                      <Price amount={activeOrder.deal.dealPrice} size=\"sm\" />\n                    </div>\n                    <div className=\"flex justify-between items-center text-xs text-gray-400 font-medium\">\n                      <span>Service Handshake Fee</span>\n                      <span>Ksh 20</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={() => setCurrentView(\'EXPLORE\')}\n                className=\"w-full h-12 border-2 border-[#FF6B00] text-[#FF6B00] hover:bg-[#FF6B00]/5 font-bold rounded-lg flex items-center justify-center gap-2 active:scale-95 transition-all shadow-sm bg-white\"\n              >\n                <span>Back to Deal Feed</span>\n              </button>\n            </motion.div>\n          )}\n\n          {/* VIEW: STUDENT PROFILE SCREEN */}\n          {currentView === \'PROFILE\' && (\n            <motion.div\n              key=\"profile\"\n              initial={{ opacity: 0, scale: 0.98 }}\n              animate={{ opacity: 1, scale: 1 }}\n              exit={{ opacity: 0, scale: 0.98 }}\n              className=\"max-w-2xl w-full mx-auto flex flex-col gap-6\"\n            >\n              {/* Profile header visual identifier */}\n              <section className=\"bg-white rounded-2xl border border-[#F3F4F6] p-6 shadow-sm flex flex-col items-center text-center relative\">\n                <div className=\"relative mb-4\">\n                  <img\n                    className=\"w-24 h-24 rounded-full object-cover border-4 border-white shadow-md\"\n                    src={user.avatar}\n                    alt={user.fullName}\n                  />\n                  <button className=\"absolute bottom-0 right-0 bg-white border border-[#F3F4F6] rounded-full p-2 text-[#FF6B00] hover:bg-[#FFF8F6] transition-colors shadow-sm active:scale-90\">\n                    <Edit3 className=\"w-4 h-4\" />\n                  </button>\n                </div>\n\n                <h2 className=\"font-display font-extrabold text-2xl tracking-tight text-[#111827] mb-1\">\n                  {user.fullName}\n                </h2>\n                <p className=\"text-xs text-gray-400 font-medium mb-3\">{user.email}</p>\n\n                {user.isVerified ? (\n                  <div className=\"inline-flex items-center gap-1.5 bg-[#FF6B00]/10 text-[#FF6B00] px-4 py-1.5 rounded-full text-xs font-bold shadow-sm\">\n                    <UserCheck className=\"w-4 h-4\" />\n                    <span>Verified Student Status</span>\n                  </div>\n                ) : (\n                  <button \n                    onClick={() => setCurrentView(\'VERIFY_STATUS\')}\n                    className=\"bg-[#E11D48] text-white px-4 py-1.5 rounded-full text-xs font-bold hover:bg-[#c1153a]\"\n                  >\n                    Unverified Student Status\n                  </button>\n                )}\n              </section>\n\n              {/* Stats Bento Grid */}\n              <section className=\"grid grid-cols-2 gap-4\">\n                <div className=\"bg-white border border-[#F3F4F6] rounded-xl p-5 shadow-sm flex flex-col justify-between items-start hover:shadow transition-shadow\">\n                  <div className=\"w-10 h-10 rounded-full bg-[#FF6B00]/10 text-[#FF6B00] flex items-center justify-center mb-4\">\n                    <TrendingDown className=\"w-5 h-5\" />\n                  </div>\n                  <div>\n                    <span className=\"block text-xs font-black text-[#5a4136] uppercase tracking-wider mb-1\">Total Savings</span>\n                    <Price amount={user.totalSaved} size=\"lg\" className=\"text-[#FF6B00]\" />\n                  </div>\n                </div>\n\n                <div className=\"bg-white border border-[#F3F4F6] rounded-xl p-5 shadow-sm flex flex-col justify-between items-start hover:shadow transition-shadow\">\n                  <div className=\"w-10 h-10 rounded-full bg-red-50 text-[#E11D48] flex items-center justify-center mb-4\">\n                    <ShoppingBag className=\"w-5 h-5\" />\n                  </div>\n                  <div>\n                    <span className=\"block text-xs font-black text-[#5a4136] uppercase tracking-wider mb-1 font-display\">Meals Enjoyed</span>\n                    <span className=\"text-2xl font-extrabold tracking-tight text-[#111827]\">{user.mealsEnjoyed} meals</span>\n                  </div>\n                </div>\n              </section>\n\n              {/* Past Orders Logs */}\n              <section className=\"space-y-4\">\n                <h3 className=\"font-display font-extrabold text-lg text-[#111827] ml-1\">\n                  Past Transactions\n                </h3>\n\n                <div className=\"flex flex-col gap-3\">\n                  {pastOrders.map((order) => (\n                    <div\n                      key={order.id}\n                      onClick={() => {\n                        if (order.status === \'Active\') {\n                          setActiveOrder(order);\n                          setCurrentView(\'ORDER_CONFIRMED\');\n                        }\n                      }}\n                      className={`bg-white border border-[#F3F4F6] rounded-xl p-4 flex gap-4 items-center shadow-sm transition-all duration-150 ${\n                        order.status === \'Active\' ? \'border-[#FF6B00] bg-[#FFF8F6] cursor-pointer hover:shadow-md\' : \'\'\n                      }`}\n                    >\n                      <img\n                        src={order.deal.image}\n                        alt={order.deal.title}\n                        className=\"w-14 h-14 rounded-lg object-cover shrink-0 border\"\n                      />\n                      \n                      <div className=\"flex-1 min-w-0\">\n                        <h4 className=\"font-display font-bold text-sm text-[#111827] truncate\">\n                          {order.deal.title}\n                        </h4>\n                        <p className=\"text-xs text-gray-400 font-medium mt-1\">\n                          {order.date} &bull; {order.time}\n                        </p>\n                      </div>\n\n                      <div className=\"flex flex-col items-end gap-1 shrink-0\">\n                        <span className={`text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full ${\n                          order.status === \'Completed\'\n                            ? \'bg-green-50 text-green-600\'\n                            : order.status === \'Cancelled\'\n                            ? \'bg-red-50 text-red-600\'\n                            : \'bg-[#FF6B00]/10 text-[#FF6B00] animate-pulse\'\n                        }`}>\n                          {order.status}\n                        </span>\n                        <Price amount={order.totalPaid} size=\"sm\" />\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </section>\n\n              {/* Log out option */}\n              <button\n                onClick={() => {\n                  setCurrentView(\'SIGN_IN\');\n                }}\n                className=\"w-full h-12 bg-gray-100 hover:bg-gray-200 text-[#5a4136] font-bold rounded-lg flex items-center justify-center gap-2 mt-4 active:scale-95 transition-all text-xs\"\n              >\n                <LogOut className=\"w-4 h-4 text-[#E11D48]\" />\n                <span>Log Out of Student Account</span>\n              </button>\n            </motion.div>\n          )}\n\n        </AnimatePresence>\n      </main>\n\n      {/* Persistent Mobile Bottom Navigation Bar */}\n      {currentView !== \'SIGN_IN\' && currentView !== \'SIGN_UP\' && currentView !== \'VERIFY_STATUS\' && currentView !== \'UPLOAD_ID\' && (\n        <nav className=\"fixed bottom-0 left-0 right-0 h-20 bg-white border-t border-gray-100 shadow-lg flex justify-around items-center px-4 z-40 rounded-t-2xl md:hidden\">\n          \n          {/* Nav Button: Explore */}\n          <button\n            onClick={() => {\n              setCurrentView(\'EXPLORE\');\n              setSelectedDeal(null);\n              setCartDeal(null);\n            }}\n            className={`flex flex-col items-center justify-center gap-1 w-16 transition-transform ${\n              currentView === \'EXPLORE\' ? \'text-[#FF6B00] scale-105\' : \'text-gray-400 hover:text-[#FF6B00]\'\n            }`}\n          >\n            <div className={`p-1.5 rounded-full ${currentView === \'EXPLORE\' ? \'bg-[#FF6B00]/10\' : \'\'}`}>\n              <Compass className=\"w-5 h-5\" />\n            </div>\n            <span className=\"text-[10px] font-bold tracking-wider uppercase\">Explore</span>\n          </button>\n\n          {/* Nav Button: Orders (Toggles Ticket if active, else alerts or takes to profile logs) */}\n          <button\n            onClick={() => {\n              if (activeOrder) {\n                setCurrentView(\'ORDER_CONFIRMED\');\n              } else {\n                setCurrentView(\'PROFILE\');\n              }\n            }}\n            className={`flex flex-col items-center justify-center gap-1 w-16 transition-transform ${\n              currentView === \'ORDER_CONFIRMED\' ? \'text-[#FF6B00] scale-105\' : \'text-gray-400 hover:text-[#FF6B00]\'\n            }`}\n          >\n            <div className={`p-1.5 rounded-full ${currentView === \'ORDER_CONFIRMED\' ? \'bg-[#FF6B00]/10\' : \'\'} relative`}>\n              <ReceiptText className=\"w-5 h-5\" />\n              {activeOrder && (\n                <span className=\"absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-[#E11D48] animate-ping\" />\n              )}\n            </div>\n            <span className=\"text-[10px] font-bold tracking-wider uppercase\">Orders</span>\n          </button>\n\n          {/* Nav Button: Profile */}\n          <button\n            onClick={() => {\n              setCurrentView(\'PROFILE\');\n              setSelectedDeal(null);\n              setCartDeal(null);\n            }}\n            className={`flex flex-col items-center justify-center gap-1 w-16 transition-transform ${\n              currentView === \'PROFILE\' ? \'text-[#FF6B00] scale-105\' : \'text-gray-400 hover:text-[#FF6B00]\'\n            }`}\n          >\n            <div className={`p-1.5 rounded-full ${currentView === \'PROFILE\' ? \'bg-[#FF6B00]/10\' : \'\'}`}>\n              <User className=\"w-5 h-5\" />\n            </div>\n            <span className=\"text-[10px] font-bold tracking-wider uppercase\">Profile</span>\n          </button>\n        </nav>\n      )}\n\n    </div>\n  );\n}\n"
    }
